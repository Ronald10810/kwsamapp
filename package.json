{
  "name": "kwsa-cloud-console",
  "version": "1.0.0",
  "description": "Modern real estate operations platform",
  "scripts": {
    "dev": "docker-compose up",
    "dev:backend": "npm run dev --prefix backend",
    "dev:backend:guarded": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:frontend:uat-parity": "powershell -ExecutionPolicy Bypass -File ./scripts/start-frontend-uat-parity.ps1",
    "env:frontend:uat-parity": "powershell -ExecutionPolicy Bypass -File ./scripts/start-frontend-uat-parity.ps1 -NoStart",
    "build": "docker-compose build",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}